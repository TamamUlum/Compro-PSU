# ============================================================================
# PT PENILAI STANDAR UJI (PSU) - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu isi nilai rahasia Anda.
# JANGAN PERNAH menyimpan kredensial atau rahasia asli ke dalam file ini!
# ============================================================================

PORT=5000
HOST=127.0.0.1
JWT_SECRET=GANTI_DENGAN_KUNCI_RAHASIA_MINIMAL_32_KARAKTER_HEX_ACAK
JWT_EXPIRES_IN=8h
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psu_company_profile
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://penilaistandaruji.com

# Konfigurasi Reverse Proxy (SEC-004 Phase 1.3 Strict Production Hardening):
# Nilai yang didukung secara aman:
# - "false" / "none" / "off" : Koneksi langsung tanpa proxy (Forwarded headers tidak dipercaya)
# - "loopback"               : Local reverse proxy / cPanel Phusion Passenger / Apache / Nginx (127.0.0.1, ::1)
# - "cloudflare"             : Di belakang Cloudflare CDN (memvalidasi CIDR resmi Cloudflare & CF-Connecting-IP)
# - "private"                : Subnet privat RFC1918 (hanya jika seluruh jaringan internal tepercaya)
# - IP/CIDR spesifik         : Contoh "10.0.1.5,192.168.1.0/24" (direkomendasikan untuk ingress proxy)
# PERHATIAN: Nilai 'true' dan numeric hop count ('1', '2', dst) DITOLAK KERAS saat startup (fail-closed)
# karena membuka celah bypass pemalsuan header IP pada koneksi langsung.
TRUST_PROXY=false

AUTH_FAIL_LIMIT_ACCOUNT=5
AUTH_FAIL_LIMIT_IP=20
AUTH_FAIL_WINDOW_MINUTES=15

