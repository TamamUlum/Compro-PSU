# ============================================================================
# PT PENILAI STANDAR UJI (PSU) - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu isi nilai rahasia Anda.
# JANGAN PERNAH menyimpan kredensial atau rahasia asli ke dalam file ini!
# ============================================================================

# Port Server API Backend
PORT=5000

# Rahasia Tanda Tangan JWT (Minimal 32 karakter acak, disarankan 64 karakter hex)
# Generate via Node.js CLI: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_KUNCI_RAHASIA_MINIMAL_32_KARAKTER_HEX_ACAK

# Durasi Sesi Token JWT (contoh: 8h, 1d)
JWT_EXPIRES_IN=8h

# Konfigurasi Koneksi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=psu_company_profile

# Domain Origin yang Diizinkan untuk CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://penilaistandaruji.com
